diff --git a/src/cpu/core_normal.cpp b/src/cpu/core_normal.cpp
index 0f937344d..c60628b4b 100644
--- a/src/cpu/core_normal.cpp
+++ b/src/cpu/core_normal.cpp
@@ -159,6 +159,41 @@ Bits CPU_Core_Normal_Run() noexcept
 		BaseDS=SegBase(ds);
 		BaseSS=SegBase(ss);
 		core.base_val_ds=ds;
+		if (getenv("DOSEMU_CPU_TRACE")) {
+			// Trace only once we're in PM (after DPMI entry), not RM
+			// code -- avoids drowning in the stub's RM init.
+			if (cpu.pmode) {
+				static int trace_count = 0;
+				static int max_lines = [](){
+					const char *env = getenv("DOSEMU_CPU_TRACE_LINES");
+					return env ? atoi(env) : 200;
+				}();
+				if (trace_count < max_lines) {
+					const PhysPt ip_lin = SegPhys(cs) + reg_eip;
+					fprintf(stderr, "[cpu%d] %04x:%08x %02x %02x %02x %02x %02x %02x (cpl=%u esp=%08x ss=%04x ssb=%08x)\n",
+					        cpu.code.big ? 32 : 16,
+					        (unsigned)SegValue(cs), (unsigned)reg_eip,
+					        mem_readb(ip_lin), mem_readb(ip_lin+1),
+					        mem_readb(ip_lin+2), mem_readb(ip_lin+3),
+					        mem_readb(ip_lin+4), mem_readb(ip_lin+5),
+					        (unsigned)cpu.cpl, (unsigned)reg_esp,
+					        (unsigned)SegValue(ss), (unsigned)SegPhys(ss));
+					trace_count++;
+				}
+			}
+		}
+		if (const char *pw = getenv("DOSEMU_BYTEWATCH")) {
+			static uint32_t pw_addr = 0;
+			static uint8_t pw_last = 0xFF;
+			if (!pw_addr) pw_addr = strtoul(pw, nullptr, 0);
+			uint8_t cur = mem_readb(pw_addr);
+			if (cur != pw_last) {
+				fprintf(stderr, "[bw] [%05x]: 0x%02x -> 0x%02x at %04x:%08x pe=%d\n",
+				        pw_addr, pw_last, cur, (unsigned)SegValue(cs),
+				        (unsigned)reg_eip, (int)cpu.pmode);
+				pw_last = cur;
+			}
+		}
 #if C_DEBUG
