+// dosiz extension: programmatic single-shot raw screenshot trigger.
+// Equivalent to the Ctrl+F5 "raw screenshot" mapper key, but callable
+// from host code (dosiz schedules it on a TIMER tick) so a guest can
+// be visually verified with no interactive display / mapper. The
+// actual PNG is written on the next CAPTURE_AddFrame, into capture_dir.
+void CAPTURE_RequestRawScreenshot()
+{
+	if (image_capturer) {
+		image_capturer->RequestRawCapture();
+	}
+}
